# ================================================================
# 树洞网站 (wzone) — Git 忽略规则
# 原则: 依赖包、打包产物、运行时文件、本地缓存与会话一律不入库;
#       锁文件(package-lock.json / pnpm-lock.yaml)与 .env.example 必须入库。
# ================================================================

# ---------------- 依赖包 ----------------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# ---------------- 打包/构建产物 ----------------
dist/
dist-ssr/
build/
out/
output/
*.tsbuildinfo

# ---------------- 日志 ----------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------- 环境变量(高德 Key / 数据库密码等敏感信息) ----------------
.env
.env.local
.env.development.local
.env.production.local
.env.*.local
!.env.example

# ---------------- 运行时目录(上传视频、H.265 转码缓存、上传图片) ----------------
uploads/
server/uploads/
tmp/
temp/

# ---------------- WorkBuddy 本地缓存/会话(绝对不能入库) ----------------
.workbuddy/

# ---------------- 编辑器与系统文件 ----------------
.vscode/
.idea/
.cache/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------- 本地备份/临时文件 ----------------
*.bak
*.orig
*.rej
